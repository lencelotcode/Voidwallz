# Public: the only values allowed in the browser bundle. Use a publishable/anon key, never a service key.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only: configure in the hosting environment, never prefix these with VITE_.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DISCORD_WEBHOOK_URL=
# Generate these using npm run security:setup; do not reuse the old studio password.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
SECURITY_LOG_SALT=
